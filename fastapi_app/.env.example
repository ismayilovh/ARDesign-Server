POSTGRES_USER=myuser
POSTGRES_PASSWORD=
POSTGRES_DB=ardesigndb
POSTGRES_HOST=db
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379/0
# Converter image launched by the Celery worker. Prefer a fixed tag for prod.
CONVERTER_IMAGE=ismayilovh/ardesign-converter:latest
MEDIA_ROOT=/app/media
# Name of the docker volume the worker mounts into converter containers.
# Physical Docker volume names. Defaults match docker-compose.prod.yml.
POSTGRES_VOLUME_NAME=ardesign-prod_postgres_data
MEDIA_VOLUME_NAME=ardesign-prod_media_data
FRONTEND_DIST_VOLUME_NAME=ardesign-prod_frontend_dist
CERTBOT_WWW_VOLUME_NAME=ardesign-prod_certbot_www
CERTBOT_CONF_VOLUME_NAME=ardesign-prod_certbot_conf
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# Set to the https URL ngrok gives you (or your domain for TLS setup).
CORS_ORIGINS=https://your-ngrok-subdomain.ngrok-free.app
DEBUG=false
# Image tag used by docker-compose.prod.yml for api and worker.
APP_VERSION=v0.1.0
